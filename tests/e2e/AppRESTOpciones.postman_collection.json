    {
      "name": "5. Proveedores y resiliencia",
      "item": [
        {
          "name": "Estado de integraciones con circuitos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}{{api}}/integraciones/estado"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('cada proveedor trae su circuito', () => ['alpaca','sec','webull','tesoro'].forEach(p => pm.expect(d[p].circuito.estado).to.be.oneOf(['cerrado','abierto','semiabierto'])));",
                  "pm.test('No revela secretos', () => pm.expect(pm.response.text()).to.not.match(/clave-de-pruebas|passwordHash|tokenHash|\"token\":/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "Proveedor sin credenciales → 503 claro",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}{{api}}/mercado/cotizaciones/AAPL/en-vivo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 503\", () => pm.response.to.have.status(503));",
                  "pm.test('nombra al proveedor', () => pm.expect(pm.response.json().message).to.match(/^\\[alpaca\\]/));",
                  "pm.test('Responde en menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test('No revela secretos', () => pm.expect(pm.response.text()).to.not.match(/clave-de-pruebas|passwordHash|tokenHash|\"token\":/i));"
                ]
              }
            }
          ]
        }
      ]
