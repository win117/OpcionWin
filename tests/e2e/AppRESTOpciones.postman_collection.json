    {
      "name": "3. CRUD con concurrencia optimista",
      "item": [
        {
          "name": "Crear empresa → 201 + ETag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{api}}/empresas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simbolo\": \"E2E{{$randomInt}}\",\n  \"nombre\": \"Empresa E2E\",\n  \"mercado\": \"NASDAQ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('revisión 1 y ETag', () => { pm.expect(d._revision).to.eql(1); pm.expect(pm.response.headers.get('ETag')).to.eql('\"1\"'); });",
                  "pm.test('el dueño no se expone', () => pm.expect(d).to.not.have.property('usuarioId'));",
                  "pm.collectionVariables.set('empresaId', d._id); pm.collectionVariables.set('simbolo', d.simbolo);",
                  "pm.test('Responde en menos de 1000 ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validación → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{api}}/empresas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simbolo\": 123\n}",
              "options": {
                "raw": {
