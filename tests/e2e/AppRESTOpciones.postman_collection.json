  "item": [
    {
      "name": "1. Plataforma",
      "item": [
        {
          "name": "Liveness /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('Responde en menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness /health/listo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/listo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('listo y aceptando trabajos', () => { pm.expect(b.estado).to.eql('listo'); pm.expect(b.cola.aceptando).to.eql(true); });",
                  "pm.test('incluye circuitos', () => pm.expect(b.proveedores.alpaca.circuito).to.be.oneOf(['cerrado','abierto','semiabierto']));",
                  "pm.test('no se guarda en caché', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        }
      ]
