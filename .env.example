# Copiar como .env solamente en instalaciones nuevas.
# No reemplazar el .env existente ni guardar credenciales en Git.
HOST=localhost
PORT=3020
API_URL=/api/v1
CONNECTION_STRING=mongodb://127.0.0.1:27017
DATABASE=db_education
DNS_SERVERS=
# Conexiones adicionales y selección por sesión: inciso D.


CORS_ORIGINS=
SUPABASE_URL=
AUTH_USERS_FILE=./private/users.json
# En la nube (Render): pegar aquí la salida de `npm run exportar:usuarios` (tiene prioridad sobre AUTH_USERS_FILE)
AUTH_USERS_JSON=
SESSION_TTL_SECONDS=3600
SUPABASE_SECRET_KEY=

# Integraciones (version funcional). Solo servidor; nunca en el navegador.
# SEC exige User-Agent con nombre y correo de contacto: "AppRESTOpciones correo@dominio".
SEC_USER_AGENT=
# Cuenta Alpaca PAPER. El entorno live esta bloqueado en codigo.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex (gratuito) o sip (suscripcion)
ALPACA_DATA_FEED=iex

# Webull OpenAPI (trading de opciones en el entorno de pruebas/sandbox; solo paper, el live esta bloqueado en codigo).
# Credenciales: developer.webull.com (App Key / App Secret). WEBULL_ACCOUNT_ID es el account_id o el numero de la cuenta de pruebas
# (si se omite y la cuenta es unica, se detecta con /trading/accounts/list).
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
# paper (unico valor permitido)
WEBULL_ENTORNO=paper
# Opcional: por defecto https://api.sandbox.webull.com (el host debe ser de pruebas)
WEBULL_BASE_URL=
# Opcional: token de acceso OAuth (x-access-token) si tu app lo exige
WEBULL_ACCESS_TOKEN=

# Saltos de proxy de confianza (0 en local, 1 en Render). Nunca "true".
TRUST_PROXY=0
# Fondos de referencia de la franja superior (configuracion; los nombres se obtienen de Alpaca)
INDICES_REFERENCIA=SPY,QQQ,IWM,DIA

# Interactive Brokers (opcional, solo cuenta simulada DU...): Client Portal Gateway en este equipo. Ver docs/interactive-brokers.md
IBKR_GATEWAY_URL=
IBKR_ACCOUNT_ID=
