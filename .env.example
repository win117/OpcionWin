# Copiar como .env solamente en instalaciones nuevas.
# No reemplazar el .env existente ni guardar credenciales en Git.
HOST=localhost
PORT=3020
API_URL=/api/v1
CONNECTION_STRING=mongodb://127.0.0.1:27017
DATABASE=db_education
DNS_SERVERS=
# Conexiones adicionales y selección por sesión: inciso D.


CORS_ORIGINS=
SUPABASE_URL=
AUTH_USERS_FILE=./private/users.json
# En la nube (Render): pegar aquí la salida de `npm run exportar:usuarios` (tiene prioridad sobre AUTH_USERS_FILE)
AUTH_USERS_JSON=
SESSION_TTL_SECONDS=3600
SUPABASE_SECRET_KEY=

# Integraciones (version funcional). Solo servidor; nunca en el navegador.
# SEC exige User-Agent con nombre y correo de contacto: "AppRESTOpciones correo@dominio".
SEC_USER_AGENT=
# Cuenta Alpaca PAPER. El entorno live esta bloqueado en codigo.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex (gratuito) o sip (suscripcion)
ALPACA_DATA_FEED=iex
